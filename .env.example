# ============================================================
# TITAN FC — пример конфигурации сервера
# Скопируйте файл в `.env` и заполните значения.
#   cp .env.example .env
# Файл `.env` находится в .gitignore и НИКОГДА не попадает в репозиторий.
# ============================================================

# --- Безопасность (обязательно) ---------------------------------
# Хеш пароля администратора. НЕ храните здесь открытый пароль.
# Сгенерировать:  npm run hash-password -- "ваш_пароль"
# Формат: scrypt$<N>$<r>$<p>$<saltBase64>$<hashBase64>
ADMIN_PASSWORD_HASH=

# Секрет для подписи сессионных cookie (случайная строка, 32+ символов)
SESSION_SECRET=

# Время жизни сессии в часах (по умолчанию 72)
SESSION_TTL_HOURS=72

# --- Сервер -------------------------------------------------------
PORT=3001
NODE_ENV=development

# Разрешённые источники для CORS (через запятую). В dev используется Vite-прокси,
# поэтому можно оставить пустым.
CORS_ORIGINS=

# --- База данных --------------------------------------------------
# Путь к файлу SQLite (по умолчанию ./data/titan.sqlite)
DATABASE_PATH=

# --- Хранилище изображений ---------------------------------------
# local — файлы на диске сервера (по умолчанию)
# s3     — S3-совместимое объектное хранилище (R2, Yandex Object Storage, MinIO...)
STORAGE_DRIVER=local

# Локальное хранилище
UPLOAD_DIR=
MAX_UPLOAD_MB=6

# S3-совместимое хранилище (нужно при STORAGE_DRIVER=s3)
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=
S3_FORCE_PATH_STYLE=true

# --- Ограничение входа --------------------------------------------
LOGIN_MAX_ATTEMPTS=6
LOGIN_WINDOW_MINUTES=15
LOGIN_LOCK_MINUTES=15
